# ============================================================
# 后现代咖啡馆 (Rainbow-box) 环境变量模板
# 使用方法：复制本文件为 .env（或 .env.local）后按需修改
#   Windows PowerShell:  Copy-Item .env.example .env
# 默认 SQLite 本地数据库无需修改 DATABASE_URL 即可运行
# ============================================================

# Database (SQLite 本地文件数据库)
DATABASE_URL="file:./prisma/dev.db"

# Auth
AUTH_SECRET="change-this-to-a-random-secret-in-production"
AUTH_URL="http://localhost:3000"

# JWT
JWT_SECRET="change-this-to-a-strong-jwt-secret-in-production"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="后现代咖啡馆"

# Upload
UPLOAD_DIR="public/uploads"
MAX_FILE_SIZE=104857600
